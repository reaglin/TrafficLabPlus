<?xml version="1.0" encoding="utf-8"?>
<!-- Eaglin.AiManager is a versioned package from the local feed, never a project reference:
     every app in this folder consumes the same built package and upgrades deliberately. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="C:\nuget-local" />
  </packageSources>
</configuration>
