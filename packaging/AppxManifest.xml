<?xml version="1.0" encoding="utf-8"?>

<!-- The Store identity Partner Center issued for TrafficLab+ (reserved by Ron, recorded 2026-10-10 in
     docs/release/DEPLOY_TO_WIN_APP_STORE.md):

       Package/Identity/Name        DeanEaglin.TrafficLab
       Package/Identity/Publisher   CN=E88392BA-A722-4B3A-8372-04403A55AA63
       PublisherDisplayName         Dean Eaglin
       Store ID                     9P5NGQF4HRPD

     The Name and Publisher below are those values, so a Store build needs no arguments.
     pack.ps1 rewrites Version from TrafficLabPlusVersion, and for a LOCAL signed test build it
     rewrites Publisher to the development certificate's subject (a package installs only when
     the two match). PublisherDisplayName must match the Partner Center account character for
     character, or certification fails. -->

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 rescap">

  <Identity
    Name="DeanEaglin.TrafficLab"
    Publisher="CN=E88392BA-A722-4B3A-8372-04403A55AA63"
    Version="1.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>TrafficLab+</DisplayName>
    <PublisherDisplayName>Dean Eaglin</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="TrafficLabPlus" Executable="TrafficLabPlus.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="TrafficLab+"
        Description="Turn a real intersection into a web page with a live traffic simulation"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="TrafficLab+"
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#0F6B4A" />
      </uap:VisualElements>

      <Extensions>
        <!-- Double-clicking a .trafficlab file starts TrafficLab+ with the path as its first argument;
             App.OnStartup opens it straight away. -->
        <uap3:Extension Category="windows.fileTypeAssociation">
          <uap3:FileTypeAssociation Name="trafficlab">
            <uap:DisplayName>TrafficLab+ study</uap:DisplayName>
            <uap:Logo>Assets\TrafficLabFile.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.trafficlab</uap:FileType>
            </uap:SupportedFileTypes>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- internetClient: the map and roads (OpenStreetMap), FDOT counts, the AI (the provider whose key
         the user entered) and publishing to GitHub Pages, each only when the user asks for it. The
         privacy policy says so: https://softwareplus.ai/trafficlab/privacy/ -->
    <Capability Name="internetClient" />
    <!-- Restricted capability, standard for a desktop app; justified at submission
         (docs/release/STORE_SUBMISSION.md). -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>

</Package>
