<Window x:Class="TrafficLabPlus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TrafficLabPlus.App.Views"
        Title="TrafficLab+" Width="1400" Height="900" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <!-- Phase 0–2: one strip and the preview. The study editor, the map and publishing
             arrive in phases 3–7 (docs/DEVELOPMENT-PLAN.md). -->
        <Border DockPanel.Dock="Top" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="#D3DAD6" Background="#EEF1EF">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="OpenStudyButton" Content="Open a study file…" Padding="10,4" Margin="0,0,8,0"
                            Click="OpenStudy_Click"
                            ToolTip="A study is the file that describes a network: its roads, signals, traffic and budget. For now, studies are JSON files; making one in the program arrives in a later version." />
                    <Button x:Name="ExampleButton" Content="Show the LPGA example" Padding="10,4" Margin="0,0,8,0"
                            Click="Example_Click"
                            ToolTip="The LPGA Blvd corridor at I-95 in Daytona Beach: a finished example study, built into TrafficLab+" />
                    <Button x:Name="BrowserButton" Content="Open in your browser" Padding="10,4" IsEnabled="False"
                            Click="Browser_Click"
                            ToolTip="Open the same page in your web browser, as a visitor would see it" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StudyTitle" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="StudyNote" Foreground="#5D6B65" TextWrapping="Wrap"
                               Text="This is the page exactly as it will be published. Try it as a visitor would: change the demand, click a road, build a plan, submit it. (Making your own study, and publishing it, arrive in later versions.)" />
                </StackPanel>
            </DockPanel>
        </Border>
        <views:PreviewView x:Name="Preview" />
    </DockPanel>
</Window>
