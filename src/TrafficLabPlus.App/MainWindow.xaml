<Window x:Class="TrafficLabPlus.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:TrafficLabPlus.App.Views"
        Title="TrafficLab+" Width="1440" Height="920" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI" FontSize="14">
    <Window.CommandBindings>
        <CommandBinding Command="New" Executed="New_Executed" />
        <CommandBinding Command="Open" Executed="Open_Executed" />
        <CommandBinding Command="Save" Executed="Save_Executed" CanExecute="HasStudy" />
        <CommandBinding Command="SaveAs" Executed="SaveAs_Executed" CanExecute="HasStudy" />
        <CommandBinding Command="Undo" Executed="Undo_Executed" CanExecute="CanUndo" />
        <CommandBinding Command="Redo" Executed="Redo_Executed" CanExecute="CanRedo" />
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="SaveAs" Key="S" Modifiers="Ctrl+Shift" />
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_New study…" Command="New" InputGestureText="Ctrl+N" />
                <MenuItem Header="_Open a study file…" Command="Open" InputGestureText="Ctrl+O" />
                <MenuItem x:Name="ExamplesMenu" Header="Open an _example" SubmenuOpened="ExamplesMenu_Opened">
                    <MenuItem Header="(examples)" IsEnabled="False" />
                </MenuItem>
                <MenuItem x:Name="RecentMenu" Header="Open _recent" SubmenuOpened="RecentMenu_Opened">
                    <MenuItem Header="(none yet)" IsEnabled="False" />
                </MenuItem>
                <Separator />
                <MenuItem Header="_Save" Command="Save" InputGestureText="Ctrl+S" />
                <MenuItem Header="Save _as…" Command="SaveAs" InputGestureText="Ctrl+Shift+S" />
                <MenuItem x:Name="CloseMenu" Header="_Close the study" Click="CloseStudy_Click" />
                <Separator />
                <MenuItem Header="E_xit" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" Command="Undo" InputGestureText="Ctrl+Z" />
                <MenuItem Header="_Redo" Command="Redo" InputGestureText="Ctrl+Y" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_Start screen: what TrafficLab+ is for" Click="StartScreen_Click" />
                <MenuItem Header="_About TrafficLab+" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- The sections down the left, in the order the work happens. -->
        <Border DockPanel.Dock="Left" Width="190" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="14,12,14,10">
                    <TextBlock x:Name="StudyName" FontWeight="SemiBold" TextWrapping="Wrap" Text="No study open" />
                    <TextBlock x:Name="SaveState" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel x:Name="Nav" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <RadioButton x:Name="NavStart" Style="{StaticResource SectionButton}" Content="Start" Tag="Start" Checked="Section_Checked"
                                 ToolTip="What TrafficLab+ is for, and the ways in" />
                    <RadioButton x:Name="NavMap" Style="{StaticResource SectionButton}" Content="1  Map" Tag="Map" Checked="Section_Checked"
                                 ToolTip="Find the intersection on a map (next version)" />
                    <RadioButton x:Name="NavNetwork" Style="{StaticResource SectionButton}" Content="2  Network" Tag="Network" Checked="Section_Checked"
                                 ToolTip="The roads and intersections: lanes, speeds, signals, turn lanes" />
                    <RadioButton x:Name="NavTraffic" Style="{StaticResource SectionButton}" Content="3  Traffic" Tag="Traffic" Checked="Section_Checked"
                                 ToolTip="How many vehicles, where they come in and go out" />
                    <RadioButton x:Name="NavChallenge" Style="{StaticResource SectionButton}" Content="4  Challenge" Tag="Challenge" Checked="Section_Checked"
                                 ToolTip="The words on the page, the budget, what each fix costs" />
                    <RadioButton x:Name="NavPreview" Style="{StaticResource SectionButton}" Content="5  Preview" Tag="Preview" Checked="Section_Checked"
                                 ToolTip="The page, full size, exactly as it will be published" />
                    <RadioButton x:Name="NavPublish" Style="{StaticResource SectionButton}" Content="6  Publish" Tag="Publish" Checked="Section_Checked"
                                 ToolTip="Save the page as a file (publishing to the web comes later)" />
                    <Border Height="1" Background="{StaticResource LineBrush}" Margin="14,8" />
                    <RadioButton x:Name="NavSettings" Style="{StaticResource SectionButton}" Content="Settings" Tag="Settings" Checked="Section_Checked" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource SectionButton}" Content="About" Tag="About" Checked="Section_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel>
            <!-- What stops the page from running, in the engine's own words; each one takes you to it. -->
            <Border x:Name="ProblemsBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{StaticResource WarnBackBrush}"
                    BorderBrush="{StaticResource WarnLineBrush}" BorderThickness="0,0,0,2" Padding="16,8">
                <StackPanel>
                    <TextBlock x:Name="ProblemsTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ItemsControl x:Name="ProblemsList" />
                </StackPanel>
            </Border>

            <Grid x:Name="Work">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="EditorColumn" Width="580" MinWidth="0" />
                    <ColumnDefinition x:Name="SplitterColumn" Width="Auto" />
                    <ColumnDefinition x:Name="PreviewColumn" Width="*" />
                </Grid.ColumnDefinitions>

                <ContentControl x:Name="SectionHost" Grid.Column="0" Background="{StaticResource PanelBrush}" Focusable="False" />
                <GridSplitter x:Name="Splitter" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="{StaticResource LineBrush}"
                              ToolTip="Drag to share the room between the form and the page" />

                <DockPanel x:Name="PreviewPane" Grid.Column="2">
                    <Border DockPanel.Dock="Top" Padding="12,6" Background="{StaticResource PageBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button x:Name="BrowserButton" DockPanel.Dock="Right" Content="Open in your browser" Padding="10,3" IsEnabled="False"
                                    Click="Browser_Click" ToolTip="Open the same page in your web browser, as a player would see it" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="The page, exactly as players will see it" />
                                <TextBlock x:Name="PreviewState" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"
                                           Text="Rebuilt after every change. Try it as a player would: build a plan, run a test, submit it." />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <views:PreviewView x:Name="Preview" />
                </DockPanel>
            </Grid>
        </DockPanel>
    </DockPanel>
</Window>
