<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>TrafficLabPlus</AssemblyName>
    <RootNamespace>TrafficLabPlus.App</RootNamespace>
    <!-- Declares PerMonitorV2; without it the app is not DPI aware and WACK warns. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrafficLabPlus.Core\TrafficLabPlus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- About ▸ Created by Dr. Ron Eaglin (Ron, 2026-09-25): the 256 px copy from GamifyPlus. -->
    <Resource Include="Images\dr-ron-eaglin.jpg" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Map section's page and Leaflet (BSD-2-Clause, Map/leaflet/LICENSE-Leaflet.txt), served
         to WebView2 from beside the program. -->
    <Content Include="Map\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
